# AIWeLink Sub2API development/gray environment.
# Copy this file to .env, replace every replace_* value, and chmod 600 .env.
# This file is a template only: never commit a real .env or paste secret values
# into an issue, chat, CI log, or Docker image tag.
#
# The development/gray instance publishes host port 8080. The production
# instance should use a separate Compose/container identity and host port 8081.
# In both cases the application listens on container port 8080.

# Compose deployment
# Compose project name. It namespaces the Compose network/volume resources;
# keep it different from the production project when both use this directory.
COMPOSE_PROJECT_NAME=sub2api-aiwelink-dev
# Explicit container name used by docker exec, logs, and health-check commands.
# Use a distinct name for production (for example, sub2api-8081).
CONTAINER_NAME=sub2api-8080
# Immutable image reference published by the aiwelink-dev GitHub Action.
# Replace the placeholder with the full dev-<12-character-merge-SHA> tag.
SUB2API_IMAGE=docker.aiwelink.cc/sub2api-aiwelink-dev:dev-REPLACE_WITH_12_CHARACTER_SHA
# Compose env file passed into the container. Relative paths are resolved from
# the directory containing the compose file; normally this must remain .env.
SUB2API_ENV_FILE=.env
# Host interface for the published port. 0.0.0.0 exposes it on every IPv4
# interface; use 127.0.0.1 when only a local reverse proxy should reach it.
BIND_HOST=0.0.0.0
# Host-side published port. This is not the container listen port: the compose
# file always maps this value to container port 8080.
SERVER_PORT=8080
# Application logging/runtime mode. Use release for the gray and production
# services; debug is intended for local troubleshooting only.
SERVER_MODE=release
# Product mode. standard enables the complete SaaS and billing behavior;
# simple is an internal mode that hides SaaS features and skips billing checks.
RUN_MODE=standard
# IANA timezone used for logs, scheduled work, and displayed timestamps.
TZ=Asia/Shanghai
# Maximum time allowed for startup database migrations, in seconds. Increase
# for a large shared database; 0 uses the built-in default (60 seconds).
SETUP_MIGRATION_TIMEOUT_SECONDS=600
# Name of the already-created external Docker network shared with the reverse
# proxy and other services. The network must exist before `compose up`.
ONEPANEL_NETWORK_NAME=1panel-network

# External PostgreSQL
# DNS name or IP reachable from inside the Sub2API container. Do not use
# localhost unless PostgreSQL runs inside the same container (it normally does
# not in this deployment).
DATABASE_HOST=replace_with_postgresql_host
# PostgreSQL TCP port exposed by the external database service.
DATABASE_PORT=5432
# Existing database/schema name containing the shared Sub2API data and
# migrations. Do not point gray and production at different databases here.
DATABASE_DBNAME=replace_with_database_name
# PostgreSQL role used by Sub2API. It needs permission to run the application
# migrations and read/write the Sub2API tables.
DATABASE_USER=replace_with_database_user
# Password for DATABASE_USER. Keep it only in the server-side .env and rotate
# it in PostgreSQL and this file together; do not add surrounding quotes.
DATABASE_PASSWORD=replace_with_database_password
# PostgreSQL SSL mode (for example disable, require, verify-ca, or verify-full).
# Use the mode required by the database provider; disable is only for a trusted
# private network where PostgreSQL traffic is already protected.
DATABASE_SSLMODE=disable
# Maximum open PostgreSQL connections for this one Sub2API process. The sum of
# this value across all gray/production replicas must fit the DB max_connections
# with headroom, otherwise requests will queue or fail during bursts.
DATABASE_MAX_OPEN_CONNS=200
# Maximum idle connections retained by this process. Keep it no higher than
# DATABASE_MAX_OPEN_CONNS; larger values consume DB slots without serving work.
DATABASE_MAX_IDLE_CONNS=20
# Maximum lifetime of one DB connection, in minutes. Recycling connections
# avoids stale connections through NAT/LB layers; 0 means no limit.
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
# Maximum idle lifetime of one DB connection, in minutes. Idle connections are
# closed after this period to release unused DB capacity; 0 means no limit.
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

# External Redis
# DNS name or IP reachable from inside the Sub2API container. Redis must be
# reachable from the same external network as the application.
REDIS_HOST=replace_with_redis_host
# Redis TCP port exposed by the external cache service.
REDIS_PORT=6379
# Redis ACL username. Leave empty when the server uses the default user only.
REDIS_USERNAME=
# Redis password/ACL secret. Leave empty only when Redis authentication is
# intentionally disabled; production should always use authentication.
REDIS_PASSWORD=replace_with_redis_password
# Logical Redis database number used by Sub2API (0-15 on the default server).
# Keep it consistent with the other Sub2API instance sharing this Redis service.
REDIS_DB=0
# Maximum pooled Redis connections for this process. Tune with Redis
# maxclients and the number of application replicas.
REDIS_POOL_SIZE=1024
# Minimum idle Redis connections kept warm. This reduces first-request latency
# but consumes client slots even when traffic is low.
REDIS_MIN_IDLE_CONNS=10
# Enable TLS for the Redis connection. Set true only when the external Redis
# endpoint presents TLS; also verify its CA configuration in the runtime.
REDIS_ENABLE_TLS=false

# Persistent application secrets. Generate each secret separately with:
# openssl rand -hex 32
# Keep both values fixed across restarts and do not reuse either for unrelated
# credentials. `openssl rand -hex 32` produces a safe 64-character value.
# JWT_SECRET signs login/session tokens; it must be at least 32 bytes and
# changing it logs out all users.
JWT_SECRET=replace_with_64_character_hex_jwt_secret
# TOTP_ENCRYPTION_KEY encrypts stored 2FA secrets; it must be exactly 64
# hexadecimal characters (32 decoded bytes). Changing it makes existing TOTP
# configurations unreadable and prevents affected users from logging in.
TOTP_ENCRYPTION_KEY=replace_with_64_character_hex_totp_key

# Promotion registration attribution. These are GROWTH_REGISTRATION_* values;
# the older GROWTH_LOGIN_* variables do not enable registration binding.
# Master switch. Keep false until Traffic, the shared database, and the domain
# cookie path have been configured; true enables the registration outbox worker.
GROWTH_REGISTRATION_ENABLED=true
# Full Traffic bind endpoint, including the reverse-proxy prefix. It must be
# reachable from inside the container and must match Traffic's deployed route.
GROWTH_REGISTRATION_ENDPOINT=https://aiwelink.cc/internal/growth/registrations/bind
# Traffic site identifier. This must match the `aiwelink` key/site configured in
# Traffic (and its DEFAULT_SITE_ID where applicable).
GROWTH_REGISTRATION_SITE_ID=aiwelink
# Server-to-server credential. Copy the value of
# SITE_SERVICE_CREDENTIALS_JSON.aiwelink from Traffic exactly, without quotes
# or whitespace. This is a service token, not an encryption key.
GROWTH_REGISTRATION_SERVICE_CREDENTIAL=replace_with_traffic_aiwelink_service_credential
# AES outbox key. Generate independently with `openssl rand -hex 32`; it must
# contain exactly 64 characters from 0-9/a-f only. Every enabled Sub2API
# instance sharing this PostgreSQL database must use the same value, but it
# must never be reused as the Traffic service credential.
GROWTH_REGISTRATION_OUTBOX_ENCRYPTION_KEY=replace_with_shared_64_character_hex_outbox_key
# Browser cookie name read by Sub2API during email registration. It must equal
# Traffic's cookie name (currently awl_growth_sid); the cookie domain must also
# cover the registration host, so testing through a raw server IP is invalid.
GROWTH_REGISTRATION_COOKIE_NAME=awl_growth_sid
# TCP connection timeout when Sub2API calls Traffic, in seconds. Keep short so
# a broken upstream does not block registration requests.
GROWTH_REGISTRATION_CONNECT_TIMEOUT_SECONDS=2
# Response-read timeout for the Traffic bind call, in seconds. The outbox worker
# retries transient failures after this timeout; it is not a user request limit.
GROWTH_REGISTRATION_READ_TIMEOUT_SECONDS=5
